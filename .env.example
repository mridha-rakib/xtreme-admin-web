# XTREME Admin Web Command Center - Environment Configuration Template
# Copy to .env.local for local overrides. Do NOT commit production secrets.

# Environment Mode: 'development' | 'qa' | 'production'
NEXT_PUBLIC_APP_ENV=development

# API Base URL (Safe development placeholder)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Mock Authentication & Personas: Restricted strictly to development/controlled QA
# In production or unknown environments, this must be 'false' to fail closed.
NEXT_PUBLIC_ENABLE_MOCK_PERSONAS=true

# Default Role for Development/QA Preview
NEXT_PUBLIC_DEFAULT_ROLE=SUPER_ADMIN
